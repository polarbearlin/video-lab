[
 {
  "t0": 0.32,
  "t1": 2.5,
  "zh": "今年二月，英国国王的亲弟弟"
 },
 {
  "t0": 2.5,
  "t1": 5.54,
  "zh": "在六十六岁生日那天，被警察带走了"
 },
 {
  "t0": 5.66,
  "t1": 8.02,
  "zh": "近四百年来，英国重要王室成员"
 },
 {
  "t0": 8.02,
  "t1": 9.64,
  "zh": "这是头一回被捕"
 },
 {
  "t0": 9.92,
  "t1": 12.92,
  "zh": "可抓他的理由，不是那桩性侵指控"
 },
 {
  "t0": 12.92,
  "t1": 15.24,
  "zh": "是爱泼斯坦文件里的几封邮件"
 },
 {
  "t0": 15.46,
  "t1": 18.42,
  "zh": "同一批文件，英国抓了两个人"
 },
 {
  "t0": 18.42,
  "t1": 21.33,
  "zh": "美国，到今年四月初，一个没抓"
 },
 {
  "t0": 21.6,
  "t1": 24.73,
  "zh": "这周民主党刚拿下众议院，说要接着查"
 },
 {
  "t0": 24.94,
  "t1": 28.75,
  "zh": "爱泼斯坦案，到底卡在哪？我们一层一层剥"
 },
 {
  "t0": 28.96,
  "t1": 32.58,
  "zh": "什么邮件？文件里有邮件似乎显示"
 },
 {
  "t0": 32.58,
  "t1": 34.54,
  "zh": "他当英国贸易特使时"
 },
 {
  "t0": 34.54,
  "t1": 37.82,
  "zh": "把官方出访香港、越南、新加坡的报告"
 },
 {
  "t0": 37.82,
  "t1": 39.28,
  "zh": "转给了爱泼斯坦"
 },
 {
  "t0": 39.28,
  "t1": 42.68,
  "zh": "有一封，看起来是收到 5 分钟就转了出去"
 },
 {
  "t0": 42.68,
  "t1": 46.05,
  "zh": "关了 11 个小时，放人，没有起诉"
 },
 {
  "t0": 46.16,
  "t1": 47.32,
  "zh": "他被捕 4 天后"
 },
 {
  "t0": 47.32,
  "t1": 50.14,
  "zh": "英国前驻美大使曼德尔森也被抓了"
 },
 {
  "t0": 50.14,
  "t1": 53.66,
  "zh": "涉嫌同一项。他没被指控任何性方面的问题"
 },
 {
  "t0": 53.66,
  "t1": 57.37,
  "zh": "律师说，逮捕源于“毫无根据的说法”"
 },
 {
  "t0": 57.66,
  "t1": 61.56,
  "zh": "到了 5 月，警方又说，要扩大对安德鲁的调查"
 },
 {
  "t0": 61.56,
  "t1": 63.72,
  "zh": "可能的性不当行为也在里面"
 },
 {
  "t0": 63.98,
  "t1": 66.6,
  "zh": "安德鲁一直否认有任何不当行为"
 },
 {
  "t0": 66.6,
  "t1": 69.32,
  "zh": "到目前的公开报道，他没被起诉"
 },
 {
  "t0": 69.54,
  "t1": 72.72,
  "zh": "那桩侵犯指控，来自一个女人"
 },
 {
  "t0": 72.72,
  "t1": 74.78,
  "zh": "弗吉尼亚·朱弗雷"
 },
 {
  "t0": 75.04,
  "t1": 77.06,
  "zh": "她说，还没成年时"
 },
 {
  "t0": 77.06,
  "t1": 79.68,
  "zh": "她在特朗普的海湖庄园打工"
 },
 {
  "t0": 79.68,
  "t1": 82.74,
  "zh": "被马克斯韦尔带到了爱泼斯坦身边"
 },
 {
  "t0": 82.74,
  "t1": 84.47,
  "zh": "马克斯韦尔否认"
 },
 {
  "t0": 84.68,
  "t1": 88.8,
  "zh": "她在回忆录里写：17 岁那年在伦敦"
 },
 {
  "t0": 88.8,
  "t1": 94.02,
  "zh": "她被带去见王子，王子一猜，就猜中她的年纪"
 },
 {
  "t0": 94.02,
  "t1": 97.78,
  "zh": "她指控，那一年遭到了他的侵犯"
 },
 {
  "t0": 98.28,
  "t1": 100.62,
  "zh": "2019 年，王子上电视"
 },
 {
  "t0": 100.62,
  "t1": 103.14,
  "zh": "说完全不记得见过她"
 },
 {
  "t0": 103.14,
  "t1": 106.08,
  "zh": "她回了一句：“我们俩之中"
 },
 {
  "t0": 106.08,
  "t1": 108.36,
  "zh": "只有一个人在说真话。”"
 },
 {
  "t0": 108.66,
  "t1": 113.1,
  "zh": "2022 年，两人庭外和解，他没有承认责任"
 },
 {
  "t0": 113.4,
  "t1": 116.94,
  "zh": "去年 4 月，她在澳大利亚的家中去世"
 },
 {
  "t0": 116.94,
  "t1": 119.42,
  "zh": "半年后，遗作出版"
 },
 {
  "t0": 119.42,
  "t1": 122.59,
  "zh": "9 天后，他的“王子”称号被收回"
 },
 {
  "t0": 122.8,
  "t1": 127.2,
  "zh": "那美国呢？去年 2 月，福克斯问司法部长邦迪"
 },
 {
  "t0": 127.2,
  "t1": 131.13,
  "zh": "会不会公布客户名单。她说：“就在我桌上。”"
 },
 {
  "t0": 131.4,
  "t1": 135.22,
  "zh": "5 个月后，司法部说：根本没有客户名单"
 },
 {
  "t0": 135.22,
  "t1": 138.71,
  "zh": "白宫和司法部解释，她指的是整个案卷"
 },
 {
  "t0": 138.76,
  "t1": 140.36,
  "zh": "国会两党坐不住了"
 },
 {
  "t0": 140.36,
  "t1": 143.96,
  "zh": "427 比 1，逼着把文件公开"
 },
 {
  "t0": 143.96,
  "t1": 146.93,
  "zh": "今年 1 月，300 多万页放了出来"
 },
 {
  "t0": 147.14,
  "t1": 149.26,
  "zh": "4 月，邦迪下台"
 },
 {
  "t0": 149.26,
  "t1": 152.78,
  "zh": "此前，两党都在批评她处理文件的方式"
 },
 {
  "t0": 153.1,
  "t1": 156.68,
  "zh": "300 多万页里，有很多你听过的名字"
 },
 {
  "t0": 156.68,
  "t1": 161.18,
  "zh": "你刷到“某某上了名单”时，先分清：被提到"
 },
 {
  "t0": 161.18,
  "t1": 162.72,
  "zh": "不等于犯罪"
 },
 {
  "t0": 163.0,
  "t1": 165.16,
  "zh": "马斯克跟特朗普闹翻那天"
 },
 {
  "t0": 165.16,
  "t1": 168.2,
  "zh": "发帖说：“该扔真正的大炸弹了"
 },
 {
  "t0": 168.2,
  "t1": 170.8,
  "zh": "特朗普在爱泼斯坦文件里。”"
 },
 {
  "t0": 170.8,
  "t1": 174.43,
  "zh": "没给证据，没过两天就删了"
 },
 {
  "t0": 174.62,
  "t1": 176.06,
  "zh": "后来公开的文件里"
 },
 {
  "t0": 176.06,
  "t1": 180.18,
  "zh": "有特朗普 90 年代坐过爱泼斯坦私人飞机的记录"
 },
 {
  "t0": 180.18,
  "t1": 183.82,
  "zh": "看起来是在他说的两人闹翻之前"
 },
 {
  "t0": 183.82,
  "t1": 186.8,
  "zh": "除了马克斯韦尔，文件里提到的人"
 },
 {
  "t0": 186.8,
  "t1": 189.08,
  "zh": "没有一个被控罪"
 },
 {
  "t0": 189.08,
  "t1": 192.56,
  "zh": "特朗普也一直否认知道爱泼斯坦的罪行"
 },
 {
  "t0": 192.56,
  "t1": 196.02,
  "zh": "克林顿夫妇被传唤，1 月拒绝作证"
 },
 {
  "t0": 196.02,
  "t1": 201.52,
  "zh": "被推进“藐视国会”程序，2 月才答应。克林顿说"
 },
 {
  "t0": 201.52,
  "t1": 203.68,
  "zh": "他不知道爱泼斯坦的罪行"
 },
 {
  "t0": 203.68,
  "t1": 206.26,
  "zh": "连共和党籍的委员会主席都说"
 },
 {
  "t0": 206.26,
  "t1": 208.75,
  "zh": "没人指控他们有不当行为"
 },
 {
  "t0": 209.02,
  "t1": 214.02,
  "zh": "美国为什么一个没抓？副司法部长布兰奇说"
 },
 {
  "t0": 214.02,
  "t1": 216.06,
  "zh": "“我们不能凭空制造证据。”"
 },
 {
  "t0": 216.38,
  "t1": 220.36,
  "zh": "被定罪的同伙马克斯韦尔，2025 年 7 月"
 },
 {
  "t0": 220.36,
  "t1": 222.94,
  "zh": "和副司法部长当面谈了两天"
 },
 {
  "t0": 222.94,
  "t1": 227.86,
  "zh": "可今年 2 月在国会，她援引第五修正案拒答"
 },
 {
  "t0": 227.86,
  "t1": 231.62,
  "zh": "律师开价：给豁免或特赦，她就说"
 },
 {
  "t0": 231.94,
  "t1": 235.5,
  "zh": "所以，卡在哪？我们的理解是"
 },
 {
  "t0": 235.5,
  "t1": 239.38,
  "zh": "英国卡在起不起诉，美国卡在证据在哪"
 },
 {
  "t0": 239.74,
  "t1": 244.48,
  "zh": "还记得那句“就在我桌上”吗？后来司法部说"
 },
 {
  "t0": 244.48,
  "t1": 246.17,
  "zh": "根本没有名单"
 },
 {
  "t0": 246.4,
  "t1": 250.24,
  "zh": "明年 1 月新国会开张，一位民主党议员说"
 },
 {
  "t0": 250.24,
  "t1": 253.66,
  "zh": "监督委员会会“接过接力棒”"
 },
 {
  "t0": 254.06,
  "t1": 260.07,
  "zh": "关注我，下一层剥开那天，接着讲"
 }
]