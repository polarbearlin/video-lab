[
 {
  "t0": 0.32,
  "t1": 2.66,
  "zh": "今年二月，英国国王的亲弟弟"
 },
 {
  "t0": 2.66,
  "t1": 5.84,
  "zh": "在六十六岁生日那天，被警察带走了"
 },
 {
  "t0": 6.16,
  "t1": 9.04,
  "zh": "近四百年来，英国重要王室成员"
 },
 {
  "t0": 9.04,
  "t1": 10.71,
  "zh": "这是头一回被捕"
 },
 {
  "t0": 11.0,
  "t1": 13.8,
  "zh": "可抓他的理由，不是那桩性侵指控"
 },
 {
  "t0": 13.8,
  "t1": 16.16,
  "zh": "是爱泼斯坦文件里的几封邮件"
 },
 {
  "t0": 16.42,
  "t1": 19.12,
  "zh": "同一批文件，英国抓了两个人"
 },
 {
  "t0": 19.12,
  "t1": 21.57,
  "zh": "美国，到今年四月初，一个没抓"
 },
 {
  "t0": 21.82,
  "t1": 25.07,
  "zh": "这周民主党刚拿下众议院，说要接着查"
 },
 {
  "t0": 25.2,
  "t1": 29.08,
  "zh": "爱泼斯坦案，到底卡在哪？我们一层一层剥"
 },
 {
  "t0": 29.28,
  "t1": 32.56,
  "zh": "什么邮件？文件里有邮件似乎显示"
 },
 {
  "t0": 32.56,
  "t1": 34.2,
  "zh": "他当英国贸易特使时"
 },
 {
  "t0": 34.2,
  "t1": 38.12,
  "zh": "把官方出访香港、越南、新加坡的报告"
 },
 {
  "t0": 38.12,
  "t1": 39.66,
  "zh": "转给了爱泼斯坦"
 },
 {
  "t0": 39.8,
  "t1": 43.23,
  "zh": "有一封，看起来是收到 5 分钟就转了出去"
 },
 {
  "t0": 43.3,
  "t1": 46.48,
  "zh": "关了 11 个小时，放人，没有起诉"
 },
 {
  "t0": 46.58,
  "t1": 47.66,
  "zh": "他被捕 4 天后"
 },
 {
  "t0": 47.66,
  "t1": 50.84,
  "zh": "英国前驻美大使曼德尔森也被抓了"
 },
 {
  "t0": 50.84,
  "t1": 54.82,
  "zh": "涉嫌同一项。他没被指控任何性方面的问题"
 },
 {
  "t0": 54.82,
  "t1": 57.85,
  "zh": "律师说，逮捕源于“毫无根据的说法”"
 },
 {
  "t0": 58.04,
  "t1": 62.2,
  "zh": "到了 5 月，警方又说，要扩大对安德鲁的调查"
 },
 {
  "t0": 62.2,
  "t1": 64.43,
  "zh": "可能的性不当行为也在里面"
 },
 {
  "t0": 64.66,
  "t1": 67.64,
  "zh": "安德鲁一直否认有任何不当行为"
 },
 {
  "t0": 67.64,
  "t1": 70.22,
  "zh": "到目前的公开报道，他没被起诉"
 },
 {
  "t0": 70.65,
  "t1": 73.11,
  "zh": "那桩性侵指控，来自一个女人"
 },
 {
  "t0": 73.11,
  "t1": 74.56,
  "zh": "弗吉尼亚·朱弗雷"
 },
 {
  "t0": 74.67,
  "t1": 76.59,
  "zh": "她说，还没成年时"
 },
 {
  "t0": 76.59,
  "t1": 78.79,
  "zh": "她在特朗普的海湖庄园打工"
 },
 {
  "t0": 78.79,
  "t1": 81.61,
  "zh": "被马克斯韦尔带到了爱泼斯坦身边"
 },
 {
  "t0": 81.61,
  "t1": 83.03,
  "zh": "马克斯韦尔否认"
 },
 {
  "t0": 83.31,
  "t1": 86.73,
  "zh": "她在回忆录里写：17 岁那年在伦敦"
 },
 {
  "t0": 86.73,
  "t1": 90.67,
  "zh": "她被带去见王子，王子一猜，就猜中她的年纪"
 },
 {
  "t0": 90.67,
  "t1": 93.02,
  "zh": "她指控，那一年遭到了他的性侵"
 },
 {
  "t0": 93.55,
  "t1": 95.69,
  "zh": "2019 年，王子上电视"
 },
 {
  "t0": 95.69,
  "t1": 97.69,
  "zh": "说完全不记得见过她"
 },
 {
  "t0": 97.69,
  "t1": 99.81,
  "zh": "她回了一句：“我们俩之中"
 },
 {
  "t0": 99.81,
  "t1": 101.54,
  "zh": "只有一个人在说真话。”"
 },
 {
  "t0": 101.65,
  "t1": 105.98,
  "zh": "2022 年，两人庭外和解，他没有承认责任"
 },
 {
  "t0": 105.98,
  "t1": 108.93,
  "zh": "去年 4 月，她在澳大利亚的家中去世"
 },
 {
  "t0": 108.93,
  "t1": 112.51,
  "zh": "家人说是自杀。半年后，遗作出版"
 },
 {
  "t0": 112.51,
  "t1": 115.33,
  "zh": "9 天后，他的“王子”称号被收回"
 },
 {
  "t0": 115.33,
  "t1": 118.59,
  "zh": "那美国呢？2025 年 2 月"
 },
 {
  "t0": 118.59,
  "t1": 120.35,
  "zh": "福克斯问司法部长邦迪"
 },
 {
  "t0": 120.35,
  "t1": 124.51,
  "zh": "会不会公布客户名单。她说：“就在我桌上。”"
 },
 {
  "t0": 124.65,
  "t1": 128.71,
  "zh": "5 个月后，司法部说：根本没有客户名单"
 },
 {
  "t0": 128.71,
  "t1": 131.98,
  "zh": "白宫和司法部解释，她指的是整个案卷"
 },
 {
  "t0": 132.09,
  "t1": 133.41,
  "zh": "国会两党坐不住了"
 },
 {
  "t0": 133.41,
  "t1": 136.91,
  "zh": "427 比 1，逼着把文件公开"
 },
 {
  "t0": 136.91,
  "t1": 139.56,
  "zh": "今年 1 月，300 多万页放了出来"
 },
 {
  "t0": 139.73,
  "t1": 141.75,
  "zh": "4 月，邦迪下台"
 },
 {
  "t0": 141.75,
  "t1": 144.78,
  "zh": "此前，两党都在批评她处理文件的方式"
 },
 {
  "t0": 145.22,
  "t1": 148.26,
  "zh": "300 多万页里，有很多你听过的名字"
 },
 {
  "t0": 148.26,
  "t1": 152.26,
  "zh": "你刷到“某某上了名单”时，先分清：被提到"
 },
 {
  "t0": 152.26,
  "t1": 153.41,
  "zh": "不等于犯罪"
 },
 {
  "t0": 153.78,
  "t1": 155.44,
  "zh": "马斯克跟特朗普闹翻那天"
 },
 {
  "t0": 155.44,
  "t1": 158.66,
  "zh": "发帖说：“该扔真正的大炸弹了"
 },
 {
  "t0": 158.66,
  "t1": 160.32,
  "zh": "特朗普在爱泼斯坦文件里。”"
 },
 {
  "t0": 160.32,
  "t1": 163.31,
  "zh": "没给证据，没过两天就删了"
 },
 {
  "t0": 163.56,
  "t1": 165.2,
  "zh": "后来公开的文件里"
 },
 {
  "t0": 165.2,
  "t1": 168.9,
  "zh": "有特朗普 90 年代坐过爱泼斯坦私人飞机的记录"
 },
 {
  "t0": 168.9,
  "t1": 171.48,
  "zh": "看起来是在他说的两人闹翻之前"
 },
 {
  "t0": 171.48,
  "t1": 173.96,
  "zh": "除了马克斯韦尔，文件里提到的人"
 },
 {
  "t0": 173.96,
  "t1": 174.96,
  "zh": "没有一个被控罪"
 },
 {
  "t0": 174.96,
  "t1": 178.32,
  "zh": "特朗普也一直否认知道爱泼斯坦的罪行"
 },
 {
  "t0": 178.4,
  "t1": 181.7,
  "zh": "克林顿夫妇被传唤，1 月拒绝作证"
 },
 {
  "t0": 181.7,
  "t1": 186.12,
  "zh": "被推进“藐视国会”程序，2 月才答应。克林顿说"
 },
 {
  "t0": 186.12,
  "t1": 188.02,
  "zh": "他不知道爱泼斯坦的罪行"
 },
 {
  "t0": 188.02,
  "t1": 190.54,
  "zh": "连共和党籍的委员会主席都说"
 },
 {
  "t0": 190.54,
  "t1": 192.95,
  "zh": "没人指控他们有不当行为"
 },
 {
  "t0": 193.0,
  "t1": 197.58,
  "zh": "美国为什么一个没抓？副司法部长布兰奇说"
 },
 {
  "t0": 197.58,
  "t1": 199.62,
  "zh": "“我们不能凭空制造证据。”"
 },
 {
  "t0": 199.8,
  "t1": 203.54,
  "zh": "被定罪的同伙马克斯韦尔，2025 年 7 月"
 },
 {
  "t0": 203.54,
  "t1": 206.26,
  "zh": "和副司法部长当面谈了两天"
 },
 {
  "t0": 206.26,
  "t1": 210.08,
  "zh": "可今年 2 月在国会，她援引第五修正案拒答"
 },
 {
  "t0": 210.08,
  "t1": 213.14,
  "zh": "律师开价：给豁免或特赦，她就说"
 },
 {
  "t0": 213.76,
  "t1": 216.28,
  "zh": "所以，卡在哪？我们的理解是"
 },
 {
  "t0": 216.28,
  "t1": 219.85,
  "zh": "英国卡在起不起诉，美国卡在证据在哪"
 },
 {
  "t0": 220.14,
  "t1": 223.46,
  "zh": "还记得那句“就在我桌上”吗？后来司法部说"
 },
 {
  "t0": 223.46,
  "t1": 225.0,
  "zh": "根本没有名单"
 },
 {
  "t0": 225.08,
  "t1": 228.54,
  "zh": "明年 1 月新国会开张，一位民主党议员说"
 },
 {
  "t0": 228.54,
  "t1": 231.0,
  "zh": "监督委员会会“接过接力棒”"
 },
 {
  "t0": 231.04,
  "t1": 236.34,
  "zh": "关注我，下一层剥开那天，接着讲"
 }
]